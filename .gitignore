apktool/
sources/
resources/
build/
dump/
native/
raw/
test/*.log
*.log

# 编辑器
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.venv/
venv/
